{
  "name": "TicketTransfer",
  "type": "object",
  "properties": {
    "secure_token": {
      "type": "string",
      "title": "Secure Transfer Token"
    },
    "ticket_snapshot": {
      "type": "string",
      "title": "Ticket Data (JSON)"
    },
    "sender_email": {
      "type": "string",
      "title": "Sender Email"
    },
    "recipient_email": {
      "type": "string",
      "title": "Recipient Email"
    },
    "recipient_user_id": {
      "type": "string",
      "title": "Recipient User ID"
    },
    "status": {
      "type": "string",
      "title": "Transfer Status",
      "enum": [
        "pending",
        "accepted",
        "declined",
        "expired",
        "cancelled"
      ],
      "default": "pending"
    },
    "expires_at": {
      "type": "string",
      "title": "Expiration Date (ISO)"
    },
    "accepted_at": {
      "type": "string",
      "title": "Accepted At (ISO)"
    },
    "declined_at": {
      "type": "string",
      "title": "Declined At (ISO)"
    },
    "cancelled_at": {
      "type": "string",
      "title": "Cancelled At (ISO)"
    },
    "event_name": {
      "type": "string",
      "title": "Event Name"
    },
    "event_date": {
      "type": "string",
      "title": "Event Date"
    },
    "venue_name": {
      "type": "string",
      "title": "Venue Name"
    },
    "ticket_count": {
      "type": "number",
      "title": "Number of Tickets",
      "default": 1
    }
  },
  "required": [
    "secure_token",
    "ticket_snapshot",
    "sender_email",
    "recipient_email",
    "status",
    "expires_at"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "data.sender_email": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "read": true,
    "update": true,
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}