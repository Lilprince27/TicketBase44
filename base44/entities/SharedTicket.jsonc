{
  "name": "SharedTicket",
  "type": "object",
  "properties": {
    "share_token": {
      "type": "string",
      "title": "Share Token"
    },
    "ticket_snapshot": {
      "type": "string",
      "title": "Ticket Data (JSON)"
    },
    "owner_email": {
      "type": "string",
      "title": "Owner Email"
    },
    "recipient_email": {
      "type": "string",
      "title": "Recipient Email"
    },
    "recipient_phone": {
      "type": "string",
      "title": "Recipient Phone Number"
    },
    "event_image": {
      "type": "string",
      "title": "Event Image URL"
    },
    "accepted_by": {
      "type": "string",
      "title": "Accepted By (recipient email)"
    },
    "accepted_date": {
      "type": "string",
      "title": "Accepted Date"
    },
    "rejected_by": {
      "type": "string",
      "title": "Rejected By (recipient email)"
    },
    "rejected_date": {
      "type": "string",
      "title": "Rejected Date"
    },
    "claimed_date": {
      "type": "string",
      "title": "Claimed Date (when ticket was added to recipient wallet)"
    }
  },
  "required": [
    "share_token",
    "ticket_snapshot",
    "owner_email"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "data.owner_email": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "read": true,
    "update": true,
    "delete": {
      "$or": [
        {
          "data.owner_email": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}