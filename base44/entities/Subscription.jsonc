{
  "name": "Subscription",
  "type": "object",
  "properties": {
    "user_email": {
      "type": "string",
      "title": "User Email"
    },
    "user_name": {
      "type": "string",
      "title": "User Name"
    },
    "duration": {
      "type": "string",
      "title": "Duration",
      "enum": [
        "2_weeks",
        "1_month",
        "3_months",
        "lifetime",
        "pro_6months"
      ]
    },
    "start_date": {
      "type": "string",
      "title": "Start Date"
    },
    "end_date": {
      "type": "string",
      "title": "End Date"
    },
    "status": {
      "type": "string",
      "title": "Status",
      "enum": [
        "active",
        "expired"
      ],
      "default": "active"
    },
    "granted_by": {
      "type": "string",
      "title": "Granted By (Admin Email)"
    },
    "maintenance_approved_month": {
      "type": "string",
      "title": "Maintenance Approved Month (YYYY-MM)"
    },
    "synced_from_axs": {
      "type": "boolean",
      "title": "Arrived From AXS Bridge",
      "default": false
    }
  },
  "required": [
    "user_email",
    "duration",
    "start_date",
    "status"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": {
      "$or": [
        {
          "data.user_email": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}