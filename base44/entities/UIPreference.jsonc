{
  "name": "UIPreference",
  "type": "object",
  "properties": {
    "user_email": {
      "type": "string",
      "title": "User Email"
    },
    "ticket_ui": {
      "type": "string",
      "enum": [
        "ui1",
        "ui2"
      ],
      "default": "ui1",
      "title": "Ticket Page UI"
    },
    "email_ui": {
      "type": "string",
      "enum": [
        "ui1",
        "ui2"
      ],
      "default": "ui2",
      "title": "Email UI"
    }
  },
  "required": [
    "user_email"
  ],
  "rls": {
    "create": {
      "data.user_email": "{{user.email}}"
    },
    "read": {
      "$or": [
        {
          "data.user_email": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "data.user_email": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}